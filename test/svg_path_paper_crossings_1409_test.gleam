// Positive control: the same encounter/filter/classify sequence retains real
// crossings. Its success must not depend on discarding every returned contact.
pub fn crossing_adapter_retains_transverse_crossings_test() {
  let left =
    svg_path.subpath_assert_polygon([
      svg_path.Point(0.0, 0.0),
      svg_path.Point(4.0, 0.0),
      svg_path.Point(4.0, 4.0),
      svg_path.Point(0.0, 4.0),
    ])
  let right =
    svg_path.subpath_assert_polygon([
      svg_path.Point(2.0, -1.0),
      svg_path.Point(6.0, -1.0),
      svg_path.Point(6.0, 2.0),
      svg_path.Point(2.0, 2.0),
    ])
  let assert Ok(found) = encounters.subpath(left, right)
  assert found.overlaps == []
  let assert Ok(filtered) =
    encounters.subpath_remove_redundant_intersections(
      found,
      left,
      right,
      intersections.default_options().tolerance,
    )
  assert list.length(filtered.intersections) == 2
  list.each(filtered.intersections, fn(hit) {
    let assert Ok([item]) =
      intersections.classify_grouped_subpath_intersection(left, right, hit)
    let assert intersections.Crossing(..) = item.classification
  })
}
