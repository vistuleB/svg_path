import gleam/list
import svg_path
import svg_path/encounters
import svg_path/intersections

fn check_no_crossings(left: svg_path.Subpath, right: svg_path.Subpath) {
  // A point-only query is not the equivalent of Paper.js getCrossings here.
  assert intersections.subpath(left, right)
    == Error(svg_path.OverlappingSegments)
  let assert Ok(found) = encounters.subpath(left, right)
  assert !list.is_empty(found.overlaps)
  assert !list.is_empty(found.intersections)
  // Exercise classification even before removing overlap-covered addresses.
  // Indeterminate is not silently counted as a non-crossing pass.
  list.each(found.intersections, fn(hit) {
    let assert Ok(classes) =
      intersections.classify_grouped_subpath_intersection(left, right, hit)
    assert !list.is_empty(classes)
    list.each(classes, fn(item) {
      let assert intersections.Touching(..) = item.classification
    })
  })
  let assert Ok(filtered) =
    encounters.subpath_remove_redundant_intersections(
      found,
      left,
      right,
      intersections.default_options().tolerance,
    )
  assert filtered.overlaps == found.overlaps
  assert filtered.intersections == []
}

