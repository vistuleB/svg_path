pub fn paper_curve_tangent_roots_1_test() {
  let velocity =
    svg_path.QuadraticBezier(
      svg_path.Point(300.0, 0.0),
      svg_path.Point(300.0, 300.0),
      svg_path.Point(0.0, 300.0),
    )
  let direction = svg_path.Point(1.0, 0.0)
  let assert Ok(found) =
    containment.segment_ray_crossings(
      velocity,
      origin: svg_path.Point(0.0, 0.0),
      direction: direction,
    )
  // Tangency is parallelism, including opposite orientation. These fixtures have
  // no zero-speed candidates; verify this before treating roots as tangents.
  list.each(found, fn(pair) {
    let v = evaluate(velocity, pair.0)
    assert v.x *. v.x +. v.y *. v.y >. 0.0
    near(v.x *. direction.y -. v.y *. direction.x, 0.0, 0.00000001)
  })
  list.length(found) |> should.equal(1)
  assert list.any(found, fn(pair) {
    float.absolute_value(pair.0 -. 0.0) <=. 0.000000001
  })
}

