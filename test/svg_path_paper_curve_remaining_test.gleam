pub fn paper_curve_division_0_test() {
  let c =
    svg_path.CubicBezier(
      svg_path.Point(0.0, 0.0),
      svg_path.Point(0.0, 0.0),
      svg_path.Point(100.0, 0.0),
      svg_path.Point(100.0, 0.0),
    )
  let assert Ok(t) = measure.segment_parameter_at_length(c, distance: 50.0)
  let assert Ok(#(left, right)) = svg_path.segment_split(c, at: t)
  point_near(svg_path.segment_end(left), svg_path.Point(50.0, 0.0), 0.000000001)
  point_near(svg_path.segment_start(right), svg_path.segment_end(left), 0.0)
  list.each([0.0, 0.25, 0.5, 0.75, 1.0], fn(u) {
    point_near(evaluate(left, u), evaluate(c, u *. t), 0.000000001)
    point_near(
      evaluate(right, u),
      evaluate(c, t +. u *. { 1.0 -. t }),
      0.000000001,
    )
  })
}

