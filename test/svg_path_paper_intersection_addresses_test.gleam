  let assert Ok(found) = intersections.path_self(svg_path.subpath_as_path(left))
  let hits =
    list.map(found, fn(hit) {
      svg_path.PathIntersection(
        point: hit.point,
        left_parameters: [hit.parameters.0],
        right_parameters: [hit.parameters.1],
      )
    })
  check(left, right, hits, [
    Expected(svg_path.Point(479.0, 495.0), Some(0), Some(0.0), Some(False)),
  ])
}

