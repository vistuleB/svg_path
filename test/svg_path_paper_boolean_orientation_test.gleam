fn boundary(from: svg_path.Path, to: svg_path.Path) {
  list.each(svg_path.path_subpaths(from), fn(subpath) {
    assert svg_path.subpath_is_closed(subpath)
    list.each(svg_path.subpath_segments(subpath), fn(segment) {
      list.each([0.0, 0.125, 0.25, 0.5, 0.75, 0.875, 1.0], fn(t) {
        let assert Ok(p) = svg_path.segment_point(segment, at: t)
        let assert Ok(d) = distance.path_distance(p, to: to)
        assert d <. 0.000001
      })
    })
  })
}

