        svg_path.Point(45.0, 30.670033755922226),
        svg_path.Point(60.670033755922226, 15.0),
        svg_path.Point(80.0, 15.0),
      ),
      svg_path.CubicBezier(
        svg_path.Point(80.0, 15.0),
        svg_path.Point(99.32996624407778, 15.0),
        svg_path.Point(115.0, 30.670033755922226),
        svg_path.Point(115.0, 50.0),
      ),
      svg_path.CubicBezier(
        svg_path.Point(115.0, 50.0),
        svg_path.Point(115.0, 69.32996624407778),
        svg_path.Point(99.32996624407778, 85.0),
        svg_path.Point(80.0, 85.0),
      ),
      svg_path.CubicBezier(
        svg_path.Point(80.0, 85.0),
        svg_path.Point(60.670033755922226, 85.0),
        svg_path.Point(45.0, 69.32996624407778),
        svg_path.Point(45.0, 50.0),
      ),
    ])
    |> svg_path.subpath_assert_close
  let assert Ok(path) =
    svg_path.path_to_lines_with(
      svg_path.subpath_as_path(original),
      options: svg_path.LinearizeOptions(tolerance: 5.0, max_depth: 20),
    )
  let assert [p] = svg_path.path_subpaths(path)
  svg_path.subpath_is_closed(p) |> should.be_true
  let segments = svg_path.subpath_segments(p)
  list.length(segments) |> should.equal(8)
  list.each(segments, fn(segment) {
    let assert svg_path.Line(start, end) = segment
    assert start != end
  })
}

