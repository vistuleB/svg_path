pub fn paper_path_join_0_test() {
  let left =
    svg_path.subpath_assert([
      svg_path.CubicBezier(
        svg_path.Point(0.0, 0.0),
        svg_path.Point(0.0, 0.0),
        svg_path.Point(10.0, 0.0),
        svg_path.Point(10.0, 0.0),
      ),
    ])
  let right =
    svg_path.subpath_assert([
      svg_path.CubicBezier(
        svg_path.Point(10.0, 0.0),
        svg_path.Point(10.0, 0.0),
        svg_path.Point(20.0, 10.0),
        svg_path.Point(20.0, 10.0),
      ),
    ])
  let assert Ok(joined) =
    svg_path.subpath_join_with([left, right], policy: svg_path.Strict)
  let points =
    list.map(svg_path.subpath_segments(joined), svg_path.segment_start)
    |> list.append([svg_path.subpath_end(joined)])
  points
  |> should.equal([
    svg_path.Point(0.0, 0.0),
    svg_path.Point(10.0, 0.0),
    svg_path.Point(20.0, 10.0),
  ])
  svg_path.subpath_is_closed(joined) |> should.equal(False)
}

