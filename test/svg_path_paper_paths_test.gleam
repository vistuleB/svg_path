pub fn paper_path_reverse_test() {
  let original =
    svg_path.subpath_assert([
      svg_path.CubicBezier(
        svg_path.Point(70.0, 100.0),
        svg_path.Point(70.0, 83.4314575050762),
        svg_path.Point(83.4314575050762, 70.0),
        svg_path.Point(100.0, 70.0),
      ),
      svg_path.CubicBezier(
        svg_path.Point(100.0, 70.0),
        svg_path.Point(116.5685424949238, 70.0),
        svg_path.Point(130.0, 83.4314575050762),
        svg_path.Point(130.0, 100.0),
      ),
      svg_path.CubicBezier(
        svg_path.Point(130.0, 100.0),
        svg_path.Point(130.0, 116.5685424949238),
        svg_path.Point(116.5685424949238, 130.0),
        svg_path.Point(100.0, 130.0),
      ),
      svg_path.CubicBezier(
        svg_path.Point(100.0, 130.0),
        svg_path.Point(83.4314575050762, 130.0),
        svg_path.Point(70.0, 116.5685424949238),
        svg_path.Point(70.0, 100.0),
      ),
    ])
    |> svg_path.subpath_assert_close
  let reversed = svg_path.subpath_reverse(original)
  let expected = [
    svg_path.CubicBezier(
      svg_path.Point(100.0, 130.0),
      svg_path.Point(116.56854, 130.0),
      svg_path.Point(130.0, 116.56854),
      svg_path.Point(130.0, 100.0),
    ),
    svg_path.CubicBezier(
      svg_path.Point(130.0, 100.0),
      svg_path.Point(130.0, 83.43146),
      svg_path.Point(116.56854, 70.0),
      svg_path.Point(100.0, 70.0),
    ),
    svg_path.CubicBezier(
      svg_path.Point(100.0, 70.0),
      svg_path.Point(83.43146, 70.0),
      svg_path.Point(70.0, 83.43146),
      svg_path.Point(70.0, 100.0),
    ),
    svg_path.CubicBezier(
      svg_path.Point(70.0, 100.0),
      svg_path.Point(70.0, 116.56854),
      svg_path.Point(83.43146, 130.0),
      svg_path.Point(100.0, 130.0),
    ),
  ]
  // Closed contours may start at different vertices; preserve directed controls.
  list.each(svg_path.subpath_segments(reversed), fn(actual) {
    let assert Ok(want) =
      list.find(expected, fn(c) {
        let a = svg_path.segment_start(actual)
        let b = svg_path.segment_start(c)
        float.absolute_value(a.x -. b.x) <. 0.00001
        && float.absolute_value(a.y -. b.y) <. 0.00001
      })
    list.each([0.0, 0.25, 0.5, 0.75, 1.0], fn(t) {
      let assert Ok(a) = svg_path.segment_point(actual, at: t)
      let assert Ok(b) = svg_path.segment_point(want, at: t)
      point_near(a, b, 0.00001)
    })
  })
  near(
    area.signed_subpath(reversed),
    0.0 -. area.signed_subpath(original),
    0.000000001,
  )
}

pub fn paper_path_flatten_24_test() {
