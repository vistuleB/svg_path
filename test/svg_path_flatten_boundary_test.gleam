        Point(-0.804520127123574, 1.339393817643834),
        Point(-1.44342, 1.33547),
      ),
      svg_path.Line(Point(-1.44342, 1.33547), Point(-1.44295, 1.25844)),
      svg_path.Line(
        Point(-1.44295, 1.25844),
        Point(-0.752200567469394, 1.262673030567845),
