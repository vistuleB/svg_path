      svg_path.Line(
        Point(-0.752200567469394, 1.262673030567845),
        Point(-0.43494, 0.94929),
      ),
      svg_path.Line(Point(-0.43494, 0.94929), Point(-0.43409, 0.80945)),
      svg_path.Line(Point(-0.43409, 0.80945), Point(-0.25009, 0.81058)),
      svg_path.Line(Point(-0.25009, 0.81058), Point(-0.25141, 1.02663)),
