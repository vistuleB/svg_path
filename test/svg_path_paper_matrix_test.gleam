import gleam/float
import gleam/option.{None}
import svg_path/affine
import svg_path/transform
import svg_path/transform/parse
import svg_path/transform/serialize

fn close(actual: Float, expected: Float) {
  assert float.absolute_value(actual -. expected) <=. 1.0e-10
}

fn column_close(a: Float, b: Float, x: Float, y: Float) {
  let scale = float.max(float.absolute_value(a), float.absolute_value(b))
  case scale >. 0.0 {
    True -> {
      assert float.absolute_value(a /. scale -. x /. scale) <=. 1.0e-12
      assert float.absolute_value(b /. scale -. y /. scale) <=. 1.0e-12
    }
    False -> {
      close(x, 0.0)
      close(y, 0.0)
    }
  }
}

fn matrix_close(actual: affine.Affine, expected: affine.Affine) {
  column_close(expected.a, expected.b, actual.a, actual.b)
  column_close(expected.c, expected.d, actual.c, actual.d)
  column_close(expected.e, expected.f, actual.e, actual.f)
}

fn check_round_trips(m: affine.Affine, f: affine.Decomposition) {
  matrix_close(affine.recompose(f), m)
  close(f.shear_x, 0.0)
  let transform = m |> affine.to_tuple |> transform.from_tuple
  let options = serialize.Options(None, False, False)
  let assert Ok(pretty) =
    parse.attribute(serialize.to_string_with(transform, options:))
  matrix_close(pretty |> transform.to_tuple |> affine.from_tuple, m)
  let assert Ok(ordered) =
    serialize.to_string_in_order(
      transform,
      order: affine.TranslationRotationShearXScale,
      options:,
    )
  let assert Ok(parsed) = parse.attribute(ordered)
  matrix_close(parsed |> transform.to_tuple |> affine.from_tuple, m)
}

