#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
active="$root/test"
backup="$root/.test-disabled/fast-tests"
runner="$root/test_slow/svg_path_test.gleam"
stress="$root/test_slow/svg_path_convex_hull_test.gleam"
support="$backup/svg_path_convex_hull_support.gleam"

restore() {
  if [ -d "$backup" ]; then
    if [ -d "$active" ]; then
      rm "$active/svg_path_test.gleam"
      rm "$active/svg_path_convex_hull_test.gleam"
      rm "$active/svg_path_convex_hull_support.gleam"
      rmdir "$active"
    fi
    mv "$backup" "$active"
    cd "$root"
    gleam clean
  fi
  rmdir "$root/.test-disabled" 2>/dev/null || true
}

trap restore EXIT INT TERM

if [ ! -f "$runner" ] || [ ! -f "$stress" ]; then
  echo "Could not find the dedicated slow-test modules." >&2
  exit 1
fi

if [ -e "$backup" ]; then
  echo "Refusing to run with an existing parked fast-test directory." >&2
  exit 1
fi

if [ ! -d "$active" ]; then
  echo "Could not find the ordinary test directory." >&2
  exit 1
fi

mkdir -p "$(dirname "$backup")"
mv "$active" "$backup"
mkdir "$active"
cp "$runner" "$active/svg_path_test.gleam"
cp "$stress" "$active/svg_path_convex_hull_test.gleam"
cp "$support" "$active/svg_path_convex_hull_support.gleam"

cd "$root"
echo "Running slow test profile (stress tests only)."
gleam clean
gleam test
