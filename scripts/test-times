#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

profile="${1:-all}"

if [ "$profile" = "all" ]; then
  echo "profile: fast"
  "$0" fast
  echo "profile: slow"
  "$0" slow
  exit 0
fi

if [ "$profile" != "fast" ] && [ "$profile" != "slow" ]; then
  echo "Usage: $0 [all|fast|slow]" >&2
  exit 1
fi

active="$root/test"
backup="$root/.test-disabled/fast-tests"
runner="$root/test_slow/svg_path_test.gleam"
stress="$root/test_slow/svg_path_convex_hull_test.gleam"
support="$backup/svg_path_convex_hull_support.gleam"

restore() {
  if [ -d "$backup" ]; then
    if [ -d "$active" ]; then
      rm "$active/svg_path_test.gleam"
      rm "$active/svg_path_convex_hull_test.gleam"
      rm "$active/svg_path_convex_hull_support.gleam"
      rmdir "$active"
    fi
    mv "$backup" "$active"
    cd "$root"
    gleam clean
  fi
  rmdir "$root/.test-disabled" 2>/dev/null || true
}

trap restore EXIT INT TERM

if [ "$profile" = "slow" ]; then
  if [ ! -d "$active" ] || [ ! -f "$runner" ] || [ ! -f "$stress" ] || [ -e "$backup" ]; then
    echo "Cannot install the isolated slow-test profile." >&2
    exit 1
  fi
  mkdir -p "$(dirname "$backup")"
  mv "$active" "$backup"
  mkdir "$active"
  cp "$runner" "$active/svg_path_test.gleam"
  cp "$stress" "$active/svg_path_convex_hull_test.gleam"
  cp "$support" "$active/svg_path_convex_hull_support.gleam"
fi

# Compile once so the measurements below contain test execution time, not
# repeated compiler startup time.
gleam clean
gleam build >/dev/null

modules=()
while IFS= read -r file; do
  module="${file#test/}"
  module="${module%.gleam}"
  module="${module//\//@}"
  modules+=("$module")
done < <(find test -type f -name '*_test.gleam' | LC_ALL=C sort)

if [ "${#modules[@]}" -eq 0 ]; then
  echo "No test modules found." >&2
  exit 1
fi

module_terms=""
for module in "${modules[@]}"; do
  if [ -n "$module_terms" ]; then
    module_terms="$module_terms,"
  fi
  module_terms="$module_terms'$module'"
done

code_paths=()
while IFS= read -r directory; do
  code_paths+=("-pa" "$directory")
done < <(find build/dev/erlang -mindepth 2 -maxdepth 2 -type d -name ebin | LC_ALL=C sort)

erl -noshell "${code_paths[@]}" -eval "
  Modules = [$module_terms],
  Run = fun(Module) ->
    {Microseconds, Result} = timer:tc(fun() ->
      eunit:test(Module, [no_tty, {scale_timeouts, 10}])
    end),
    io:format(\"~s\\t~.6f\\t~p~n\", [atom_to_list(Module), Microseconds / 1000000, Result]),
    case Result of ok -> ok; _ -> halt(1) end
  end,
  lists:foreach(Run, Modules),
  halt(0).
"
