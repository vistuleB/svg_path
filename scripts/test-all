#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
active="$root/test/svg_path_convex_hull_test.gleam"
parked="$root/.test-disabled/svg_path_convex_hull_test.gleam"

if [ -f "$parked" ] && [ ! -f "$active" ]; then
  mkdir -p "$(dirname "$active")"
  mv "$parked" "$active"
fi
rmdir "$(dirname "$parked")" 2>/dev/null || true

if [ ! -f "$active" ]; then
  echo "Could not find svg_path_convex_hull_test.gleam in test/." >&2
  exit 1
fi

cd "$root"
"$root/scripts/test-fast"
"$root/scripts/test-slow"
