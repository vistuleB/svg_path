  {
    "test": "allows to avoid spaces after arc flags",
    "kind": "serialize",
    "options": {
      "pathData": [
        {
          "command": "M",
          "args": [
            0,
            0
          ]
        },
        {
          "command": "A",
          "args": [
            50,
            50,
            10,
            1,
            0,
            0.2,
            20
          ]
        },
        {
          "command": "a",
          "args": [
            50,
            50,
            10,
            1,
            0,
            0.2,
            20
          ]
        },
        {
          "command": "a",
          "args": [
            50,
            50,
            10,
            1,
            0,
            0.2,
            20
          ]
        }
      ],
      "disableSpaceAfterFlags": false
    },
    "expected": "M0 0A50 50 10 1 0 .2 20a50 50 10 1 0 .2 20 50 50 10 1 0 .2 20",
    "actual": "m0 0a50 50 10 10.2 20 50 50 10 10.2 20 50 50 10 10.2 20",
    "classification": "geometry-model-versus-command-list-serialization"
  },
