[
  {
    "test": "should allow spaces between commands",
    "kind": "parse",
    "input": "M0 10 L \n\r\t20 30",
    "expected": [
      {
        "command": "M",
        "args": [
          0,
          10
        ]
      },
      {
        "command": "L",
        "args": [
          20,
          30
        ]
      }
    ],
    "accepted": true,
    "classification": "matching-geometry"
  },
  {
    "test": "should allow spaces and commas between arguments",
    "kind": "parse",
    "input": "M0 , 10 L 20 \n\r\t30,40,50",
    "expected": [
      {
        "command": "M",
        "args": [
          0,
          10
        ]
      },
      {
        "command": "L",
        "args": [
          20,
          30
        ]
      },
      {
        "command": "L",
        "args": [
          40,
          50
        ]
      }
    ],
    "accepted": true,
    "classification": "matching-geometry"
  },
