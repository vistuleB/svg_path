  {
    "test": "should avoid space before first, negative and decimals",
    "kind": "serialize",
    "options": {
      "pathData": [
        {
          "command": "M",
          "args": [
            0,
            -1.2
          ]
        },
        {
          "command": "L",
          "args": [
            0.3,
            4
          ]
        },
        {
          "command": "L",
          "args": [
            5,
            -0.6
          ]
        },
        {
          "command": "L",
          "args": [
            7,
            0.8
          ]
        }
      ]
    },
    "expected": "M0-1.2.3 4 5-.6 7 .8",
    "actual": "m0-1.2 .3 5.2 4.7-4.6 2 1.4",
    "classification": "geometry-model-versus-command-list-serialization"
  },
  {
    "test": "should have a space before scientific notation",
