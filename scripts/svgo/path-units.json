    "options": {
      "pathData": [
        {
          "command": "M",
          "args": [
            0,
            -1.9876
          ]
        },
        {
          "command": "L",
          "args": [
            0.3,
            3.14159265
          ]
        },
        {
          "command": "L",
          "args": [
            -0.3,
            -3.14159265
          ]
        },
        {
          "command": "L",
          "args": [
            100,
            200
          ]
        }
      ],
      "precision": 3
    },
