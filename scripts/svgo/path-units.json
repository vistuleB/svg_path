  {
    "test": "should handle arcs",
    "kind": "parse",
    "input": "\n          M600,350\n          l 50,-25\n          a25,25 -30 0,1 50,-25\n          25,50 -30 0,1 50,-25\n          25,75 -30 01.2,-25\n          a25,100 -30 0150,-25\n          l 50,-25\n        ",
    "expected": [
      {
        "command": "M",
        "args": [
          600,
          350
        ]
      },
      {
        "command": "l",
        "args": [
          50,
          -25
        ]
      },
      {
        "command": "a",
        "args": [
          25,
          25,
          -30,
          0,
          1,
          50,
          -25
        ]
      },
      {
        "command": "a",
        "args": [
          25,
          50,
          -30,
          0,
          1,
          50,
          -25
        ]
      },
      {
        "command": "a",
        "args": [
          25,
          75,
          -30,
          0,
          1,
          0.2,
          -25
        ]
      },
      {
        "command": "a",
        "args": [
          25,
          100,
          -30,
          0,
          1,
          50,
          -25
        ]
      },
      {
        "command": "l",
        "args": [
          50,
          -25
        ]
      }
    ],
    "accepted": true,
    "classification": "matching-geometry"
  },
  {
    "test": "should normalize signed arc radii",
    "kind": "parse",
    "input": "M0 0A-10 +20 0 0 1 30 40a+50 -60 0 1 0 70 80",
    "expected": [
      {
        "command": "M",
        "args": [
          0,
          0
        ]
      },
      {
        "command": "A",
        "args": [
          10,
          20,
          0,
          0,
          1,
          30,
          40
        ]
      },
      {
        "command": "a",
        "args": [
          50,
          60,
          0,
          1,
          0,
          70,
          80
        ]
      }
    ],
    "accepted": true,
    "classification": "explicit-radius-normalization"
  },
  {
    "test": "should combine sequence of the same commands",
    "kind": "serialize",
    "options": {
      "pathData": [
        {
          "command": "M",
          "args": [
            0,
            0
          ]
        },
        {
          "command": "h",
          "args": [
            10
          ]
        },
        {
          "command": "h",
          "args": [
            20
          ]
        },
        {
          "command": "h",
          "args": [
            30
          ]
        },
        {
          "command": "H",
          "args": [
            40
          ]
        },
        {
          "command": "H",
          "args": [
            50
          ]
        }
      ]
    },
    "expected": "M0 0h10 20 30H40 50",
    "actual": "m0 0 10 0h20 30-20 10",
    "classification": "geometry-model-versus-command-list-serialization"
  },
  {
