#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"
# Compare the documented module with the source compiled by gleam test.
if ! awk '
  /<!-- tested-recipes:start -->/ { recipe = 1; next }
  /<!-- tested-recipes:end -->/ { recipe = 0; next }
  recipe && !/^```/ { print }
' README.md | cmp - test/readme_recipes.gleam; then
  echo "README recipe code differs from test/readme_recipes.gleam" >&2
  exit 1
fi
