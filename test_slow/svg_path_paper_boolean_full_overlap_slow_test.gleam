fn boundary_samples(from: svg_path.Path, to: svg_path.Path) {
  list.each(svg_path.path_subpaths(from), fn(subpath) {
    svg_path.subpath_is_closed(subpath) |> should.be_true
    list.each(svg_path.subpath_segments(subpath), fn(segment) {
      list.each([0.0, 0.25, 0.5, 0.75, 1.0], fn(t) {
        let assert Ok(p) = svg_path.segment_point(segment, at: t)
        let assert Ok(d) = distance.path_distance(p, to: to)
        assert d <=. 0.001
      })
    })
  })
}

fn check(
  actual: svg_path.Path,
  expected: svg_path.Path,
  xs: List(Float),
  ys: List(Float),
) {
  // Rounded upstream coordinates and different subdivisions need geometric checks.
  let want = float.absolute_value(area.signed_path(expected))
  let got = float.absolute_value(area.signed_path(actual))
  assert float.absolute_value(got -. want) <=. 0.00001 *. float.max(1.0, want)
  boundary_samples(actual, expected)
  boundary_samples(expected, actual)
  list.each(xs, fn(x) {
    list.each(ys, fn(y) {
      let p = svg_path.Point(x, y)
      let assert Ok(a) = distance.path_distance(p, to: actual)
      let assert Ok(b) = distance.path_distance(p, to: expected)
      case a >. 0.001 && b >. 0.001 {
        True -> {
          let assert Ok(want) =
            containment.path_containment(p, expected, svg_path.Nonzero)
          containment.path_containment(p, actual, svg_path.Nonzero)
          |> should.equal(Ok(want))
        }
        False -> Nil
      }
    })
  })
}

