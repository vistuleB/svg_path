import gleam/float
import gleam/list
import gleam/option.{type Option, None, Some}
import svg_path
import svg_path/encounters
import svg_path/intersections

type Expected {
  Expected(
    point: svg_path.Point,
    index: Option(Int),
    time: Option(Float),
    crossing: Option(Bool),
  )
}

fn near(a: svg_path.Point, b: svg_path.Point, tolerance: Float) -> Bool {
  let dx = a.x -. b.x
  let dy = a.y -. b.y
  dx *. dx +. dy *. dy <=. tolerance *. tolerance
}

fn expected_address_matches(
  address: svg_path.SubpathParameter,
  expected: Expected,
) -> Bool {
  {
    case expected.index {
      Some(index) -> address.segment_index == index
      None -> True
    }
  }
  && {
    case expected.time {
      Some(t) ->
        case t == 0.0 || t == 1.0 {
          True -> address.t == t
          False -> float.absolute_value(address.t -. t) <=. 0.0000051
        }
      None -> True
    }
  }
}

fn check(
  left: svg_path.Subpath,
  right: svg_path.Subpath,
  hits: List(svg_path.PathIntersection),
  expected: List(Expected),
) {
  let a = svg_path.subpath_as_path(left)
  let b = svg_path.subpath_as_path(right)
  let tolerance = intersections.default_options().tolerance
  list.each(hits, fn(hit) {
    assert !list.is_empty(hit.left_parameters)
    assert !list.is_empty(hit.right_parameters)
    list.each(hit.left_parameters, fn(l) {
      assert l.subpath_index == 0
      let assert Ok(lp) = svg_path.path_point(a, at: l)
      assert near(lp, hit.point, tolerance)
      list.each(hit.right_parameters, fn(r) {
        assert r.subpath_index == 0
        let assert Ok(rp) = svg_path.path_point(b, at: r)
        assert near(rp, hit.point, tolerance)
        assert near(lp, rp, tolerance)
        let assert Ok(class) =
          intersections.classify_subpath_intersection(
            left,
            right,
            first_parameter: l.at,
            second_parameter: r.at,
          )
        assert class != intersections.Indeterminate
      })
    })
  })
  // Source points are rounded, and source parameters usually have five decimals.
  // Match by point AND address, without depending on solver output ordering.
  list.each(expected, fn(want) {
    let candidates =
      list.filter(hits, fn(hit) {
        float.absolute_value(hit.point.x -. want.point.x) <=. 0.00001
        && float.absolute_value(hit.point.y -. want.point.y) <=. 0.00001
        && list.any(hit.left_parameters, fn(p) {
          expected_address_matches(p.at, want)
        })
      })
    assert !list.is_empty(candidates)
    list.each(candidates, fn(hit) {
      list.each(
        list.filter(hit.left_parameters, fn(p) {
          expected_address_matches(p.at, want)
        }),
        fn(l) {
          list.each(hit.right_parameters, fn(r) {
            let assert Ok(class) =
              intersections.classify_subpath_intersection(
                left,
                right,
                first_parameter: l.at,
                second_parameter: r.at,
              )
            case want.crossing {
              Some(True) -> {
                let assert intersections.Crossing(..) = class
                Nil
              }
              Some(False) -> {
                assert case class {
                  intersections.Touching(..)
                  | intersections.EndpointContact(..) -> True
                  _ -> False
                }
              }
              None -> Nil
            }
          })
        },
      )
    })
  })
}

