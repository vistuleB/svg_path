import svg_path/parse

fn row(values: List(Float)) -> String {
  "[" <> string.join(list.map(values, float.to_string), ",") <> "]"
}

fn describe(data: String) -> String {
  case parse.path(data) {
    Error(error) -> string.inspect(Error(error))
    Ok(path) ->
      "Ok(["
      <> string.join(
        list.map(svg_path.path_subpaths(path), fn(sp) {
          let closed = case svg_path.subpath_is_closed(sp) {
            True -> 1.0
            False -> 0.0
          }
          "["
          <> string.join(
            [
              row([closed]),
              ..list.map(svg_path.subpath_segments(sp), fn(segment) {
                case segment {
                  svg_path.Line(start: a, end: b) ->
                    row([a.x, a.y, a.x, a.y, b.x, b.y, b.x, b.y])
                  _ -> {
                    let assert [
                      svg_path.CubicBezier(
                        start: a,
                        control1: b,
                        control2: c,
                        end: d,
                      ),
                    ] = svg_path.segment_to_cubic_beziers(segment)
                    row([a.x, a.y, b.x, b.y, c.x, c.y, d.x, d.y])
                  }
                }
              })
            ],
            ",",
          )
          <> "]"
        }),
        ",",
      )
      <> "])"
  }
}

