// Generated by generate-curve-locations.py. Offsets are measured prefix lengths.
import gleam/float
import gleam/io
import gleam/list
import gleam/result
import gleam/string
import svg_path
import svg_path/measure

fn probe(
  sp: svg_path.Subpath,
  index: Int,
  expected_distance: Float,
) -> Result(List(Float), svg_path.Error) {
  let at = case index {
    3 -> svg_path.SubpathParameter(2, 1.0)
    _ -> svg_path.SubpathParameter(index, 0.0)
  }
  use prefix <- result.try(case index {
    0 -> Ok(svg_path.subpath_empty(at: svg_path.subpath_start(sp)))
    _ ->
      svg_path.subpath_between(
        sp,
        from: svg_path.SubpathParameter(0, 0.0),
        to: at,
      )
  })
  use distance <- result.try(measure.subpath_length(prefix))
  use point <- result.try(svg_path.subpath_point(sp, at: at))
  // Supplementary inverse check, using the upstream expected distance.
  use inverse <- result.try(measure.subpath_point_at_length(
    sp,
    distance: expected_distance,
  ))
  Ok([distance, point.x, point.y, inverse.x, inverse.y])
}

fn emit(label: String, value: Result(List(Float), svg_path.Error)) {
  let text = case value {
    Ok(values) ->
      "Ok([" <> string.join(list.map(values, float.to_string), ",") <> "])"
    Error(error) -> string.inspect(Error(error))
  }
  io.println(label <> ":" <> text)
}

pub fn main() {
  let cubic =
    svg_path.subpath_assert([
      svg_path.CubicBezier(
        svg_path.Point(100.0, 100.0),
        svg_path.Point(100.0, 100.0),
        svg_path.Point(200.0, 100.0),
        svg_path.Point(200.0, 100.0),
      ),
      svg_path.CubicBezier(
        svg_path.Point(200.0, 100.0),
        svg_path.Point(200.0, 100.0),
        svg_path.Point(300.0, 100.0),
        svg_path.Point(300.0, 100.0),
      ),
      svg_path.CubicBezier(
        svg_path.Point(300.0, 100.0),
        svg_path.Point(300.0, 100.0),
        svg_path.Point(400.0, 100.0),
        svg_path.Point(400.0, 100.0),
      ),
    ])
  let lines =
    svg_path.subpath_assert_polyline([
      svg_path.Point(100.0, 100.0),
      svg_path.Point(200.0, 100.0),
      svg_path.Point(300.0, 100.0),
      svg_path.Point(400.0, 100.0),
    ])
  emit("cubic-0", probe(cubic, 0, 0.0))
  emit("cubic-1", probe(cubic, 1, 100.0))
  emit("cubic-2", probe(cubic, 2, 200.0))
  emit("cubic-3", probe(cubic, 3, 300.0))
  emit("lines-0", probe(lines, 0, 0.0))
  emit("lines-1", probe(lines, 1, 100.0))
  emit("lines-2", probe(lines, 2, 200.0))
  emit("lines-3", probe(lines, 3, 300.0))
}
