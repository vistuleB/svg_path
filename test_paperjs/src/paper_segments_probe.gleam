// Adapted from pinned Paper.js Segment.js, MIT license in upstream source.
// Generated by generate-segments.py. One node becomes one closed cubic:
// start/end = node; control1 = node + handleOut; control2 = node + handleIn.
// This tests geometric handle reversal, not in-place object mutation.
import gleam/float
import gleam/io
import gleam/list
import gleam/string
import svg_path

pub fn main() {
  let curve =
    svg_path.CubicBezier(
      svg_path.Point(10.0, 10.0),
      svg_path.Point(25.0, 25.0),
      svg_path.Point(15.0, 15.0),
      svg_path.Point(10.0, 10.0),
    )
  let sp = svg_path.subpath_assert([curve]) |> svg_path.subpath_assert_close
  let reversed = svg_path.subpath_reverse(sp)
  let assert [svg_path.CubicBezier(start: a, control1: b, control2: c, end: d)] =
    svg_path.subpath_segments(reversed)
  let values = [a.x, a.y, c.x -. d.x, c.y -. d.y, b.x -. a.x, b.y -. a.y]
  io.println(
    "10:[" <> string.join(list.map(values, float.to_string), ",") <> "]",
  )
  io.println("closed:" <> string.inspect(svg_path.subpath_is_closed(reversed)))
  io.println("continuous:" <> string.inspect(a == d))
  // Supplementary identity: reversing the path twice restores its geometry.
  io.println(
    "double_reverse:"
    <> string.inspect(svg_path.subpath_reverse(reversed) == sp),
  )
}
