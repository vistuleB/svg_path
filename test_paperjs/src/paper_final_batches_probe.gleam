import gleam/float
import gleam/io
import gleam/list
import gleam/option.{None}
import gleam/string
import svg_path
import svg_path/area
import svg_path/basic_shapes
import svg_path/internal/root
import svg_path/parse

fn emit_roots(id: String, values: Result(List(Float), root.Error)) {
  let output = case values {
    Ok(values) ->
      "Ok([" <> string.join(list.map(values, float.to_string), ",") <> "])"
    Error(error) -> string.inspect(Error(error))
  }
  io.println(id <> ":" <> output)
}

pub fn main() {
  emit_roots("numerical-0", Ok(root.quadratic(1.0, 0.0, -1.0)))
  emit_roots(
    "numerical-1",
    Ok(root.quadratic(0.000000000001, 0.0, -0.000000000001)),
  )
  emit_roots("numerical-2", root.cubic(0.5, -1.0, -1.0, -1.0))
  emit_roots(
    "numerical-3",
    root.cubic(
      0.0000000000005,
      -0.000000000001,
      -0.000000000001,
      -0.000000000001,
    ),
  )
  let parsed =
    parse.path(
      "M279.0 151.0 L149.0 151.0 L149.0 281.0 L279.0 281.0 M319.0 321.0 L109.0 321.0 L109.0 111.0 L319.0 111.0",
    )
  case parsed {
    Ok(path) ->
      io.println(
        "compound-0:"
        <> string.inspect(list.length(svg_path.path_subpaths(path))),
      )
    Error(e) -> io.println("compound-0:" <> string.inspect(Error(e)))
  }
  let shape = basic_shapes.rect(300.0, 300.0, 100.0, 100.0, None, None)
  case shape {
    Ok(sp) ->
      io.println(
        "compound-1:" <> string.inspect(area.signed_subpath(sp) >. 0.0),
      )
    Error(e) -> io.println("compound-1:" <> string.inspect(Error(e)))
  }
  let shape = basic_shapes.rect(50.0, 50.0, 200.0, 200.0, None, None)
  case shape {
    Ok(sp) ->
      io.println(
        "compound-2:" <> string.inspect(area.signed_subpath(sp) >. 0.0),
      )
    Error(e) -> io.println("compound-2:" <> string.inspect(Error(e)))
  }
  let shape = basic_shapes.rect(0.0, 0.0, 500.0, 500.0, None, None)
  case shape {
    Ok(sp) ->
      io.println(
        "compound-3:" <> string.inspect(area.signed_subpath(sp) >. 0.0),
      )
    Error(e) -> io.println("compound-3:" <> string.inspect(Error(e)))
  }
}
