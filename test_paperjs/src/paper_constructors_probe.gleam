import gleam/float
import gleam/io
import gleam/list
import gleam/option.{None, Some}
import gleam/result
import gleam/string
import svg_path
import svg_path/basic_shapes

fn coordinates(segment: svg_path.Segment) -> List(Float) {
  case segment {
    svg_path.Line(start: a, end: b) -> [a.x, a.y, a.x, a.y, b.x, b.y, b.x, b.y]
    svg_path.CubicBezier(start: a, control1: b, control2: c, end: d) -> [
      a.x,
      a.y,
      b.x,
      b.y,
      c.x,
      c.y,
      d.x,
      d.y,
    ]
    _ -> panic as "Unexpected constructor segment after explicit arc conversion"
  }
}

fn inspect_shape(
  shape: Result(svg_path.Subpath, basic_shapes.Error),
) -> String {
  let output =
    shape
    |> result.map(fn(subpath) {
      // First row records closure; subsequent rows are line/cubic coordinates.
      let closed = case svg_path.subpath_is_closed(subpath) {
        True -> 1.0
        False -> 0.0
      }
      let cubics = subpath |> svg_path.subpath_arcs_to_cubic_beziers
      [[closed], ..list.map(svg_path.subpath_segments(cubics), coordinates)]
    })
  case output {
    Ok(rows) ->
      "Ok(["
      <> string.join(
        list.map(rows, fn(row) {
          "[" <> string.join(list.map(row, float.to_string), ",") <> "]"
        }),
        ",",
      )
      <> "])"
    Error(error) -> string.inspect(Error(error))
  }
}

pub fn main() {
  io.println(
    "0:"
    <> inspect_shape(basic_shapes.rect(50.0, 50.0, 100.0, 100.0, None, None)),
  )
  io.println(
    "1:"
    <> inspect_shape(basic_shapes.rect(50.0, 50.0, 100.0, 100.0, None, None)),
  )
  io.println("2:" <> inspect_shape(basic_shapes.circle(100.0, 100.0, 50.0)))
  io.println("3:" <> inspect_shape(basic_shapes.circle(100.0, 100.0, 50.0)))
  io.println(
    "5:" <> inspect_shape(basic_shapes.ellipse(1000.0, 875.0, 500.0, 375.0)),
  )
  io.println(
    "6:"
    <> inspect_shape(basic_shapes.rect(
      50.0,
      50.0,
      200.0,
      100.0,
      Some(20.0),
      Some(20.0),
    )),
  )
  io.println(
    "7:"
    <> inspect_shape(basic_shapes.rect(
      50.0,
      50.0,
      200.0,
      100.0,
      Some(20.0),
      Some(20.0),
    )),
  )
  io.println(
    "8:"
    <> inspect_shape(basic_shapes.rect(
      50.0,
      50.0,
      200.0,
      100.0,
      Some(200.0),
      Some(200.0),
    )),
  )
  io.println("19:" <> inspect_shape(basic_shapes.line(20.0, 20.0, 40.0, 40.0)))
  io.println("20:" <> inspect_shape(basic_shapes.line(20.0, 20.0, 40.0, 40.0)))
}
