import gleam/float
import gleam/io
import gleam/string
import svg_path/affine

fn emit(id: String, m: affine.Affine) {
  let output = case affine.decompose(m) {
    Ok(f) ->
      float.to_string(f.rotation_degrees)
      <> ","
      <> float.to_string(f.scale_x)
      <> ","
      <> float.to_string(f.scale_y)
    Error(error) -> string.inspect(error)
  }
  io.println(id <> ":" <> output)
}

